APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:gi36EXymYaf1EVIHk8MBCPZJl4LVICtlkWqPPgI8qok=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afwo_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email / Reset Password (contoh Gmail SMTP) ---
# Gmail memerlukan App Password 16 karakter (bukan password login Gmail).
# Aktifkan Verifikasi 2 Langkah, lalu buat App Password di akun Google.
# MAIL_FROM_ADDRESS harus sama dengan MAIL_USERNAME.
# Untuk port 587 gunakan MAIL_SCHEME=smtp.
# Setelah mengubah .env jalankan: php artisan config:clear
# QUEUE_CONNECTION boleh tetap database karena notifikasi reset password
# dikirim sinkron, bukan melalui antrean.
# Untuk pengembangan tanpa SMTP: MAIL_MAILER=log, lalu baca tautan reset
# di storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=alamat@gmail.com
MAIL_PASSWORD=app-password-16-karakter
MAIL_FROM_ADDRESS=alamat@gmail.com
MAIL_FROM_NAME="AFWO Hair Design"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_LIMIT=30

VITE_APP_NAME="${APP_NAME}"